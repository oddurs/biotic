#!/bin/sh
# The stack seam. CI, git hooks, and scripts/agent talk to the toolchains only through here.
#
#   scripts/task fmt        format in place
#   scripts/task fmt:check  verify formatting; non-zero on drift
#   scripts/task lint       lint and typecheck; warnings are errors
#   scripts/task test       full test suites
#   scripts/task build      build the wheel and sdist into dist/, and the site into web/apps/site/dist/
#   scripts/task check      fmt:check && lint && test && build
#   scripts/task version [x.y.z]  print the project version, or set it (and the lockfile)
#
# Two toolchains live here: uv for bio/ and pnpm for web/. Both are pinned (uv.lock,
# pnpm-lock.yaml) and both fail loudly if the lockfile is stale.
set -eu
cd "$(dirname "$0")/.."

run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

# `uv run --locked` syncs .venv from uv.lock first and fails if the lockfile is stale,
# so a green check here means exactly the same thing in CI.
py() { run uv run --locked "$@"; }

# The web half runs when something under web/ (or this script) differs from the default
# branch or is uncommitted, or when TASK_SCOPE=all (CI sets it, so CI always runs everything).
# A change to bio/ alone cannot affect the site, so its gate stays short.
web_in_scope() {
  [ "${TASK_SCOPE:-}" = "all" ] && return 0
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  def=$(scripts/default-branch 2>/dev/null) || return 0
  git rev-parse --verify --quiet "origin/$def" >/dev/null || return 0
  if ! git diff --quiet "origin/$def...HEAD" -- web scripts/task 2>/dev/null; then return 0; fi
  if [ -n "$(git status --porcelain -- web scripts/task)" ]; then return 0; fi
  return 1
}

# pnpm: install from the lockfile when node_modules is missing or older than it.
web() {
  if ! web_in_scope; then
    printf '~ web: no changes under web/, skipped (TASK_SCOPE=all to force)\n' >&2
    return 0
  fi
  if [ ! -d web/node_modules ] || [ web/pnpm-lock.yaml -nt web/node_modules/.modules.yaml ]; then
    run pnpm --dir web install --frozen-lockfile
  fi
  run pnpm --dir web "$@"
}

case "${1:-}" in
  fmt)       py ruff format . && web fmt ;;
  fmt:check) py ruff format --check . && web fmt:check ;;
  lint)      py ruff check . && web lint && web typecheck ;;
  test)      py pytest && web test ;;
  build)     run uv build && web build ;;
  version)   if [ -n "${2:-}" ]; then run uv version "$2"; else uv version --short; fi ;;
  check)
    "$0" fmt:check
    "$0" lint
    "$0" test
    "$0" build
    ;;
  *)
    sed -n '4,11p' "$0" >&2
    exit 2
    ;;
esac
