{
  "extends": ["astro/tsconfigs/strict", "../../tsconfig.base.json"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["astro/client", "node"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src",
    "e2e",
    "site.config.ts",
    "astro.config.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["dist"]
}
