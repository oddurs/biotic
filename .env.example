# The mind: any OpenAI-compatible chat endpoint. Copy to .env (git-ignored).
OPENROUTER_API_KEY=
BIOTIC_MODEL=google/gemini-2.5-flash-lite  # chosen by experiment 0041 (cheapest USD/viable at pass_rate>=0.7). see docs/experiments.md
# BIOTIC_BUDGET_USD=2.00   # dollars a dish may spend on the mind; inf for no cap. see docs/budget.md
# BIOTIC_NOTES_EVERY=600   # ticks between the naturalist's field notes; 0 turns it off. see docs/naturalist.md
# BIOTIC_MUTAGEN_CLOCK=tick        # wall | tick; default by command (live: wall, run: tick). see docs/experiments.md
# BIOTIC_MUTAGEN_EVERY_TICKS=40    # tick clock: least ticks between calls to the mind
# BIOTIC_MUTAGEN=mixed             # llm | random | mixed; which mutagen a division rolls. see docs/mutagen.md
# BIOTIC_RANDOM_SHARE=0.25         # mixed: fraction of rolls to the offline random control arm
# BIOTIC_VESSEL=vessel     # the dish directory to act on; --vessel overrides it. see docs/flasks.md

# Fully local instead, with Ollama running (no key needed):
# BIOTIC_BASE_URL=http://localhost:11434/v1
# BIOTIC_MODEL=qwen2.5-coder:7b
